# Build outputs (any level; the repo-root build/ holds the fetched libil2cpp copy
# and all native/managed build artifacts -- never committed, see ps2port.txt section 8)
build/
obj/
bin/

# IDE / editor state. Personal, machine-specific ignore rules belong in
# .git/info/exclude rather than here, so this file stays about the project.
*.user
.vs/
.idea/

# The internal engineering plan. Kept locally as the authority for the work,
# not distributed with the source. Documentation cites it as "plan section N".
ps2port.txt

# Toolchain tarballs (ps2dev prebuilt releases etc.)
*.tar.gz

# unitee.dev website source -- deployed separately, not part of the toolchain
LandingPage/

# Unity-side transient folders -- scoped to the trees that contain Unity projects
# (sample projects and the UPM package dev host), not the whole repo.
samples/**/Library/
samples/**/Temp/
samples/**/Logs/
samples/**/UserSettings/
unity-package/**/Library/
unity-package/**/Temp/
unity-package/**/Logs/
unity-package/**/UserSettings/

# Locally installed tools, like the ps2dev toolchain and PCSX2: fetched by
# the developer, not vendored. mkps2iso is needed from M12 (ISO packaging).
# Delete this line if you decide to commit the binaries deliberately.
/tools/mkps2iso/

# Python bytecode from the tools/ scripts.
__pycache__/
*.pyc
