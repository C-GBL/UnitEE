root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,inl}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
