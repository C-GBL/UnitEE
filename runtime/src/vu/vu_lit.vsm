; runtime/src/vu/vu_lit.vsm
;
; VU1 transform + per-vertex lighting (plan section 9, M4 tasks 3 and 4), the
; `vu_lit` material kind from section 7.3: up to 4 directional lights plus
; ambient, computed per vertex.
;
; Same pipeline as vu_unlit with a lighting stage inserted, and the same
; per-triangle near-plane + guard-band rejection. Four lights are ONE 4x4
; matrix multiply, not four dot products: light directions are packed as the
; COLUMNS of a matrix, so MULAx/MADDAy/MADDz produces all four N.L terms as a
; single vector. Light colours are stored split by channel (a qword of four
; reds, one of greens, one of blues) so the four intensities are applied with
; three MULA/MADD chains. That packing is why lighting is affordable here.
;
; FLAG DISCIPLINE (learned the hard way in vu_unlit): every upper instruction
; updates the sticky status flags, and both the lighting and the transform
; produce negative intermediates. The clip tests therefore run in an isolated
; window after ALL other upper arithmetic: FSSET 0, three test SUBs, >=4 pairs
; of upper NOPs, FSAND bit 7 (sticky S).
;
; ---------------------------------------------------------------------------
; VU1 DATA MEMORY LAYOUT (quadwords)
; ---------------------------------------------------------------------------
;   0..3    MVP matrix, column-major
;   4       viewport scale   : (sx, sy, sz, 0)
;   5       viewport offset  : (ox, oy, oz, 0)
;   6       clip constants   : (4095, 4095, 0, w_near)
;   7       GIF tag template
;   8       vertex count     : (n, 0, 0, 0) integer in x; n multiple of 3
;   9..11   light direction matrix rows x/y/z, one COLUMN per light,
;           pre-negated, normalised, in OBJECT space (EE supplies them, so the
;           microprogram needs no inverse-transpose)
;   12..14  light colour R / G / B: (l0, l1, l2, l3) per channel
;   15      ambient          : (r, g, b, 0)
;   16      colour clamp     : (255, 255, 255, 128) -- GS ceiling; 128 = opaque
;   17      reserved
;   18..    vertices, 3 qwords each: position (x,y,z,1), normal (x,y,z,0),
;           colour (r,g,b,a)
;
; Output from qword 300: tag, then RGBAQ + XYZ2 per vertex.
; Capacity: (300-18)/3 = 94 vertices in, 1+2*94 = 189 out (300+189 < 1024).

		.vu
		.align 4
		.global	VuLit_CodeStart
		.global	VuLit_CodeEnd

VuLit_CodeStart:

; --- Per-batch constants ----------------------------------------------------
		NOP							lq		VF01, 0(VI00)
		NOP							lq		VF02, 1(VI00)
		NOP							lq		VF03, 2(VI00)
		NOP							lq		VF04, 3(VI00)
		NOP							lq		VF05, 4(VI00)		; viewport scale
		NOP							lq		VF06, 5(VI00)		; viewport offset
		NOP							lq		VF30, 6(VI00)		; clip constants
		NOP							lq		VF07, 7(VI00)		; GIF tag
		NOP							ilw.x	VI05, 8(VI00)		; vertex count
		NOP							lq		VF20, 9(VI00)		; light dirs x row
		NOP							lq		VF21, 10(VI00)		; light dirs y row
		NOP							lq		VF22, 11(VI00)		; light dirs z row
		NOP							lq		VF23, 12(VI00)		; light colour R
		NOP							lq		VF24, 13(VI00)		; light colour G
		NOP							lq		VF25, 14(VI00)		; light colour B
		NOP							lq		VF26, 15(VI00)		; ambient
		NOP							lq		VF28, 16(VI00)		; clamp

		FTOI4	VF31, VF00			iaddiu	VI08, VI00, 300		; degenerate pt

		NOP							sq		VF07, 0(VI08)
		NOP							iaddiu	VI08, VI08, 1
		NOP							iaddiu	VI06, VI00, 18		; input cursor
		NOP							iaddiu	VI07, VI00, 0		; vertex counter

tri_loop:
		NOP							iadd	VI11, VI00, VI00	; reject accum
		NOP							iadd	VI12, VI08, VI00	; tri out base

; ============================ vertex 0 =======================================
		NOP							lq		VF10, 0(VI06)		; position
		NOP							lq		VF16, 1(VI06)		; normal
		NOP							lq		VF11, 2(VI06)		; colour
; lighting: all four N.L at once, clamp negatives, accumulate channels
		MULAx	ACC, VF20, VF16x	NOP
		MADDAy	ACC, VF21, VF16y	NOP
		MADDz	VF17, VF22, VF16z	NOP
		MAX		VF17, VF17, VF00	NOP
		MULAx	ACC, VF23, VF17x	NOP
		MADDAy	ACC, VF24, VF17y	NOP
		MADDAz	ACC, VF25, VF17z	NOP
		MADDw	VF18, VF26, VF00w	NOP							; + ambient
		MUL		VF19, VF18, VF11	NOP							; x vertex colour
		MINI	VF19, VF19, VF28	NOP							; clamp high
		MAX		VF19, VF19, VF00	NOP							; clamp low
; transform
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF19			NOP
; isolated clip-test window
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF30	NOP
		SUB.xy	VF29, VF13, VF00	NOP
		SUB.xy	VF29, VF30, VF13	NOP
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 3

; ============================ vertex 1 =======================================
		NOP							lq		VF10, 0(VI06)
		NOP							lq		VF16, 1(VI06)
		NOP							lq		VF11, 2(VI06)
		MULAx	ACC, VF20, VF16x	NOP
		MADDAy	ACC, VF21, VF16y	NOP
		MADDz	VF17, VF22, VF16z	NOP
		MAX		VF17, VF17, VF00	NOP
		MULAx	ACC, VF23, VF17x	NOP
		MADDAy	ACC, VF24, VF17y	NOP
		MADDAz	ACC, VF25, VF17z	NOP
		MADDw	VF18, VF26, VF00w	NOP
		MUL		VF19, VF18, VF11	NOP
		MINI	VF19, VF19, VF28	NOP
		MAX		VF19, VF19, VF00	NOP
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF19			NOP
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF30	NOP
		SUB.xy	VF29, VF13, VF00	NOP
		SUB.xy	VF29, VF30, VF13	NOP
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 3

; ============================ vertex 2 =======================================
		NOP							lq		VF10, 0(VI06)
		NOP							lq		VF16, 1(VI06)
		NOP							lq		VF11, 2(VI06)
		MULAx	ACC, VF20, VF16x	NOP
		MADDAy	ACC, VF21, VF16y	NOP
		MADDz	VF17, VF22, VF16z	NOP
		MAX		VF17, VF17, VF00	NOP
		MULAx	ACC, VF23, VF17x	NOP
		MADDAy	ACC, VF24, VF17y	NOP
		MADDAz	ACC, VF25, VF17z	NOP
		MADDw	VF18, VF26, VF00w	NOP
		MUL		VF19, VF18, VF11	NOP
		MINI	VF19, VF19, VF28	NOP
		MAX		VF19, VF19, VF00	NOP
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF19			NOP
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF30	NOP
		SUB.xy	VF29, VF13, VF00	NOP
		SUB.xy	VF29, VF30, VF13	NOP
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 3
		NOP							iaddiu	VI07, VI07, 3

; --- Reject patch ------------------------------------------------------------
		NOP							ibeq	VI11, VI00, tri_ok
		NOP							NOP
		NOP							sq		VF31, 1(VI12)
		NOP							sq		VF31, 3(VI12)
		NOP							sq		VF31, 5(VI12)
tri_ok:
		NOP							ibne	VI07, VI05, tri_loop
		NOP							NOP

; --- Kick --------------------------------------------------------------------
		NOP							iaddiu	VI09, VI00, 300
		NOP							xgkick	VI09

		NOP[E]						NOP
		NOP							NOP
		.align 4
VuLit_CodeEnd:
