; runtime/src/vu/vu_unlit.vsm
;
; VU1 transform microprogram (plan section 9, M4 tasks 2 and 4), the `vu_unlit`
; material kind from section 7.3: texture x vertex colour, no lighting.
;
; Per vertex: transform to clip space, perspective divide, viewport map, GS
; 12.4 fixed-point conversion, packed into a GIF packet in VU data memory and
; sent with one XGKICK per batch.
;
; CLIPPING (M4 task 4, the staged version the plan asks for first):
; per TRIANGLE, reject when any of its three vertices is
;   - behind the near plane (clip-space w < near), or
;   - outside the guard band (screen x or y outside 0..4095 GS pixels).
; A rejected triangle has its three XYZ2 qwords overwritten with a degenerate
; point far off-screen, so it rasterises nothing. This is rejection, not true
; clipping: a triangle straddling the near plane POPS rather than being cut.
; True near-plane clipping is the follow-up the plan schedules after this
; version is proven; without THIS version, a vertex behind the camera divides
; by a negative/zero w and the 16-bit packed coordinates wrap, which draws
; garbage smears across the whole screen.
;
; The guard band matters for the same reason: GS packed X/Y are 16-bit 12.4,
; so anything past 4095 pixels wraps back into the visible range. 0..4095 is
; a huge margin around the 512x448 screen (scissor culls the rest), so this
; almost never rejects a visible triangle.
;
; HOW THE TESTS WORK -- and the trap that broke the first version. The VU
; status register keeps STICKY flags, and EVERY upper-pipeline instruction
; updates them: a transform whose intermediate values are negative (half of
; all clip-space coordinates!) sets sticky S just as surely as a failed test.
; So the three test SUBs must run in an ISOLATED window: finish ALL transform
; arithmetic first, then FSSET 0 to clear the stickies, then only the test
; SUBs (upper NOPs write no flags), then FSAND at least 4 pairs after the last
; SUB (the flag pipeline latency). FSAND bit 7 = sticky sign.
;
; ---------------------------------------------------------------------------
; VU1 DATA MEMORY LAYOUT (quadwords), written by the EE via VIF UNPACK
; ---------------------------------------------------------------------------
;   0..3    MVP matrix, column-major (VF01..VF04)
;   4       viewport scale   : (sx, sy, sz, 0)
;   5       viewport offset  : (ox, oy, oz, 0)
;   6       clip constants   : (4095, 4095, 0, w_near)
;   7       GIF tag template
;   8       vertex count     : (n, 0, 0, 0) integer in x; n multiple of 3
;   9       reserved
;   10..    vertices, 2 qwords each: position (x,y,z,1), colour (r,g,b,a)
;
; Output is built from qword 200: tag, then RGBAQ + XYZ2 per vertex.
; Capacity: (200-10)/2 = 95 vertices in, 1+2*95 = 191 out (200+191 < 1024).

		.vu
		.align 4
		.global	VuUnlit_CodeStart
		.global	VuUnlit_CodeEnd

VuUnlit_CodeStart:

; --- Per-batch constants ----------------------------------------------------
		NOP							lq		VF01, 0(VI00)
		NOP							lq		VF02, 1(VI00)
		NOP							lq		VF03, 2(VI00)
		NOP							lq		VF04, 3(VI00)
		NOP							lq		VF05, 4(VI00)		; viewport scale
		NOP							lq		VF06, 5(VI00)		; viewport offset
		NOP							lq		VF26, 6(VI00)		; clip constants
		NOP							lq		VF07, 7(VI00)		; GIF tag
		NOP							ilw.x	VI05, 8(VI00)		; vertex count

; Degenerate point for rejected triangles: FTOI4 of (0,0,0,1) = int (0,0,0,16).
; GS (0,0) is 2048 px off-screen and the three identical points have zero area.
		FTOI4	VF31, VF00			iaddiu	VI08, VI00, 200

		NOP							sq		VF07, 0(VI08)		; emit the tag
		NOP							iaddiu	VI08, VI08, 1
		NOP							iaddiu	VI06, VI00, 10		; input cursor
		NOP							iaddiu	VI07, VI00, 0		; vertex counter

tri_loop:
		NOP							iadd	VI11, VI00, VI00	; reject accum = 0
		NOP							iadd	VI12, VI08, VI00	; this tri's out base

; ============================ vertex 0 =======================================
		NOP							lq		VF10, 0(VI06)
		NOP							lq		VF11, 1(VI06)
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP							; VF12 = clip space
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP							; VF12 preserved
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP							; VF13 = GS pixels
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF11			NOP
; --- isolated clip-test window (no other upper op may write flags here) -----
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF26	NOP							; w < near ?
		SUB.xy	VF29, VF13, VF00	NOP							; x<0 or y<0 ?
		SUB.xy	VF29, VF26, VF13	NOP							; x>4095 or y>4095 ?
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080			; sticky S
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 2

; ============================ vertex 1 =======================================
		NOP							lq		VF10, 0(VI06)
		NOP							lq		VF11, 1(VI06)
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF11			NOP
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF26	NOP
		SUB.xy	VF29, VF13, VF00	NOP
		SUB.xy	VF29, VF26, VF13	NOP
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 2

; ============================ vertex 2 =======================================
		NOP							lq		VF10, 0(VI06)
		NOP							lq		VF11, 1(VI06)
		MULAx	ACC, VF01, VF10x	NOP
		MADDAy	ACC, VF02, VF10y	NOP
		MADDAz	ACC, VF03, VF10z	NOP
		MADDw	VF12, VF04, VF10w	NOP
		NOP							div		Q, VF00w, VF12w
		NOP							waitq
		MULq	VF13, VF12, Q		NOP
		MUL		VF13, VF13, VF05	NOP
		ADD		VF13, VF13, VF06	NOP
		FTOI4	VF14, VF13			NOP
		FTOI0	VF15, VF11			NOP
		NOP							fsset	0x000
		SUB.w	VF29, VF12, VF26	NOP
		SUB.xy	VF29, VF13, VF00	NOP
		SUB.xy	VF29, VF26, VF13	NOP
		NOP							NOP
		NOP							NOP
		NOP							NOP
		NOP							fsand	VI10, 0x080
		NOP							ior		VI11, VI11, VI10
		NOP							sq		VF15, 0(VI08)
		NOP							sq		VF14, 1(VI08)
		NOP							iaddiu	VI08, VI08, 2
		NOP							iaddiu	VI06, VI06, 2
		NOP							iaddiu	VI07, VI07, 3

; --- Reject patch: any flagged vertex degenerates the whole triangle --------
; (branch delay slots execute unconditionally; keep them NOP)
		NOP							ibeq	VI11, VI00, tri_ok
		NOP							NOP
		NOP							sq		VF31, 1(VI12)
		NOP							sq		VF31, 3(VI12)
		NOP							sq		VF31, 5(VI12)
tri_ok:
		NOP							ibne	VI07, VI05, tri_loop
		NOP							NOP

; --- Kick the finished packet ------------------------------------------------
		NOP							iaddiu	VI09, VI00, 200
		NOP							xgkick	VI09

		NOP[E]						NOP
		NOP							NOP
		.align 4
VuUnlit_CodeEnd:
